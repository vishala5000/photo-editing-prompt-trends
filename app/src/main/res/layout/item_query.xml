<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="10dp"
    android:background="?attr/selectableItemBackground">

    <TextView android:id="@+id/tvSource"
        android:layout_width="24dp" android:layout_height="24dp"
        android:textSize="14sp" android:gravity="center"
        android:layout_marginEnd="6dp"/>

    <TextView android:id="@+id/tvQuery"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="#212121" android:maxLines="2" android:ellipsize="end"/>

    <TextView android:id="@+id/tvInterest"
        android:layout_width="35dp" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="#666" android:gravity="center"/>

    <TextView android:id="@+id/tvPercent"
        android:layout_width="55dp" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:gravity="end"/>
</LinearLayout>
