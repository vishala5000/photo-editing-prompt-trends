<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#FAFAFA">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🎯 Smart Keyword Finder" android:textSize="20sp" android:textStyle="bold"
        android:textColor="#1a1a1a" android:paddingBottom="4dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="YouTube Suggestions → Video Filter (<50K views/subs, <7 days) → Google Trends"
        android:textSize="11sp" android:textColor="#666" android:paddingBottom="8dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="8dp">
        <EditText android:id="@+id/etSearch"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:hint="🔍 Enter keyword..."
            android:padding="12dp" android:background="@android:drawable/edit_text"
            android:textSize="14sp" android:textStyle="bold"/>
        <Button android:id="@+id/btnRefresh" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="🚀 GO" android:textSize="12sp"
            android:layout_marginStart="4dp" android:backgroundTint="#1976D2"/>
    </LinearLayout>

    <TextView android:id="@+id/tvActiveKeyword" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="💡 Enter a keyword above and tap GO"
        android:textSize="12sp" android:textStyle="bold" android:textColor="#1976D2"
        android:padding="8dp" android:background="#E3F2FD" android:layout_marginBottom="4dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnCopyAll" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="📋 Copy All" android:textSize="12sp"
            android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnExpandAll" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="📂 Expand All" android:textSize="12sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <TextView android:id="@+id/statusText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Ready. Waiting for your keyword..."
        android:textSize="11sp" android:textColor="#444" android:padding="6dp"
        android:background="#FFF3E0" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>

    <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone"/>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView" android:layout_width="match_parent"
            android:layout_height="match_parent" android:background="#FFFFFF"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
